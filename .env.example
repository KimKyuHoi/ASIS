# macOS 공증(notarize)용 Apple 계정 정보.
# `pnpm build:mac` 으로 로컬에서 서명·공증 빌드를 할 때 electron-builder 가 읽는다.
# CI(.github/workflows/release.yml)는 이 파일 대신 GitHub Secrets 를 사용한다.
#
# 이 파일을 `.env` 로 복사한 뒤 본인 값으로 채우세요 — `.env` 는 커밋하지 않는다.

# Apple Developer 계정 이메일
APPLE_ID=

# https://appleid.apple.com 에서 발급한 앱 암호 (일반 계정 비밀번호가 아님)
APPLE_APP_SPECIFIC_PASSWORD=

# Apple Developer 팀 ID (10자리)
APPLE_TEAM_ID=
